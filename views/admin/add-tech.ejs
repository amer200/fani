<h2 style="
    color: #f5f5f7; 
    font-size: 1.8rem; 
    font-weight: 700; 
    margin-bottom: 25px; 
    position: relative; 
    padding-bottom: 10px;
">
    إضافة فني جديد <span style="color: #ffcc00;">للمنظومة</span>
    <span style="
        position: absolute; 
        bottom: 0; 
        right: 0; 
        width: 50px; 
        height: 3px; 
        background: #ffcc00; 
        border-radius: 2px;
    "></span>
</h2>

<div style="
    background: rgba(30, 30, 30, 0.75); 
    backdrop-filter: blur(10px); 
    -webkit-backdrop-filter: blur(10px);
    padding: 30px; 
    border-radius: 14px; 
    max-width: 500px; 
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
">
    <form action="/admin/add-tech" method="POST" style="display: flex; flex-direction: column; gap: 20px;">

        <div style="display: flex; flex-direction: column; gap: 8px;">
            <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">اسم الفني بالكامل</label>
            <input type="text" name="name" required placeholder="أدخل اسم الفني رباعي" style="
                width: 100%; 
                padding: 12px 14px; 
                background: #121212; 
                border: 1px solid #3a3a3c; 
                border-radius: 8px; 
                color: #ffffff; 
                font-size: 0.95rem; 
                outline: none; 
                box-sizing: border-box;
                transition: all 0.3s ease;
            " onfocus="this.style.borderColor='#ffcc00'; this.style.boxShadow='0 0 0 3px rgba(255, 204, 0, 0.15)';" onblur="this.style.borderColor='#3a3a3c'; this.style.boxShadow='none';">
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px;">
            <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">رقم الهاتف <span style="color: #ffcc00; font-size: 0.8rem;">(سيستخدم كاسم مستخدم)</span></label>
            <input type="tel" name="phone" required placeholder="01xxxxxxxxx" style="
                width: 100%; 
                padding: 12px 14px; 
                background: #121212; 
                border: 1px solid #3a3a3c; 
                border-radius: 8px; 
                color: #ffffff; 
                font-size: 0.95rem; 
                outline: none; 
                box-sizing: border-box;
                direction: ltr; 
                text-align: right;
                transition: all 0.3s ease;
            " onfocus="this.style.borderColor='#ffcc00'; this.style.boxShadow='0 0 0 3px rgba(255, 204, 0, 0.15)';" onblur="this.style.borderColor='#3a3a3c'; this.style.boxShadow='none';">
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px;">
            <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">كلمة المرور</label>
            <input type="password" name="password" required placeholder="••••••••" style="
                width: 100%; 
                padding: 12px 14px; 
                background: #121212; 
                border: 1px solid #3a3a3c; 
                border-radius: 8px; 
                color: #ffffff; 
                font-size: 0.95rem; 
                outline: none; 
                box-sizing: border-box;
                direction: ltr;
                text-align: right;
                transition: all 0.3s ease;
            " onfocus="this.style.borderColor='#ffcc00'; this.style.boxShadow='0 0 0 3px rgba(255, 204, 0, 0.15)';" onblur="this.style.borderColor='#3a3a3c'; this.style.boxShadow='none';">
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px;">
            <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">التخصص الأساسي</label>
            <div style="position: relative; width: 100%;">
                <select name="specialty" style="
                    width: 100%; 
                    padding: 12px 14px; 
                    background: #121212; 
                    border: 1px solid #3a3a3c; 
                    border-radius: 8px; 
                    color: #ffffff; 
                    font-size: 0.95rem; 
                    outline: none; 
                    box-sizing: border-box;
                    cursor: pointer;
                    appearance: none;
                    -webkit-appearance: none;
                    -moz-appearance: none;
                ">
                    <option value="تركيب">🛠️ تركيب</option>
                    <option value="صيانة">⚡ صيانة</option>
                </select>
                <div style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #aeaeae; pointer-events: none; font-size: 0.8rem;">▼</div>
            </div>
        </div>

        <button type="submit" style="
            background: #ffcc00; 
            color: #000000; 
            padding: 14px 20px; 
            border: none; 
            border-radius: 8px; 
            cursor: pointer; 
            font-weight: 700; 
            font-size: 1rem;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(255, 204, 0, 0.2);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        " onmouseover="this.style.background='#e6b800'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 20px rgba(255, 204, 0, 0.3)';" onmouseout="this.style.background='#ffcc00'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(255, 204, 0, 0.2)';"
            onmousedown="this.style.transform='translateY(1px)';" onmouseup="this.style.transform='translateY(-1px)';">
            حفظ البيانات واعتماد الفني
        </button>
    </form>
</div>