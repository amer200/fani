<div class="top-bar" style="
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    margin-bottom: 30px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
">
    <h1 style="
        font-size: 1.8rem; 
        font-weight: 700; 
        color: #f5f5f7; 
        margin: 0;
    ">
        إضافة مهمة جديدة للفنيين
    </h1>
    <div class="user-info">
        <a href="/admin/dashboard" style="
            color: var(--accent, #ffcc00); 
            text-decoration: none; 
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        " onmouseover="this.style.color='#e6b800';" onmouseout="this.style.color='var(--accent, #ffcc00)';">
            <i class="fas fa-arrow-right" style="font-size: 0.85rem;"></i> العودة للوحة التحكم
        </a>
    </div>
</div>

<div style="
    max-width: 800px; 
    margin: 0 auto; 
    background: rgba(30, 30, 30, 0.75); 
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 35px; 
    border-radius: 16px; 
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
">
    <form action="/admin/add-task" method="POST" style="display: flex; flex-direction: column; gap: 25px;">

        <div>
            <h3 style="
                color: var(--accent, #ffcc00); 
                font-size: 1.15rem; 
                border-bottom: 1px solid rgba(255, 255, 255, 0.08); 
                padding-bottom: 10px; 
                margin-top: 0;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
            ">
                <i class="fas fa-user" style="font-size: 1rem;"></i> بيانات العميل الأساسية
            </h3>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">اسم العميل بالكامل</label>
                    <input type="text" name="clientName" required placeholder="مثال: محمد أحمد علي" style="
                        width: 100%; background: #121212; border: 1px solid #3a3a3c; color: white; padding: 12px 14px; border-radius: 8px; outline: none; font-size: 0.95rem; box-sizing: border-box; transition: all 0.3s ease;
                    " onfocus="this.style.borderColor='#ffcc00'; this.style.boxShadow='0 0 0 3px rgba(255, 204, 0, 0.15)';" onblur="this.style.borderColor='#3a3a3c'; this.style.boxShadow='none';">
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">رقم الهاتف</label>
                    <input type="tel" name="clientPhone" required placeholder="01XXXXXXXXX" style="
                        width: 100%; background: #121212; border: 1px solid #3a3a3c; color: white; padding: 12px 14px; border-radius: 8px; outline: none; font-size: 0.95rem; box-sizing: border-box; direction: ltr; text-align: right; transition: all 0.3s ease;
                    " onfocus="this.style.borderColor='#ffcc00'; this.style.boxShadow='0 0 0 3px rgba(255, 204, 0, 0.15)';" onblur="this.style.borderColor='#3a3a3c'; this.style.boxShadow='none';">
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">العنوان بالتفصيل</label>
                <input type="text" name="clientAddress" required placeholder="مثال: أسوان - حي العقاد - بجوار مسجد النصر" style="
                    width: 100%; background: #121212; border: 1px solid #3a3a3c; color: white; padding: 12px 14px; border-radius: 8px; outline: none; font-size: 0.95rem; box-sizing: border-box; transition: all 0.3s ease;
                " onfocus="this.style.borderColor='#ffcc00'; this.style.boxShadow='0 0 0 3px rgba(255, 204, 0, 0.15)';" onblur="this.style.borderColor='#3a3a3c'; this.style.boxShadow='none';">
            </div>
        </div>

        <div>
            <h3 style="
                color: var(--accent, #ffcc00); 
                font-size: 1.15rem; 
                border-bottom: 1px solid rgba(255, 255, 255, 0.08); 
                padding-bottom: 10px; 
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
            ">
                <i class="fas fa-tools" style="font-size: 1rem;"></i> تفاصيل المهمة وتعيين المسؤول
            </h3>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">نوع المهمة</label>
                    <div style="position: relative; width: 100%;">
                        <select name="taskType" style="
                            width: 100%; background: #121212; border: 1px solid #3a3a3c; color: white; padding: 12px 14px; border-radius: 8px; outline: none; font-size: 0.95rem; cursor: pointer; box-sizing: border-box; appearance: none; -webkit-appearance: none; -moz-appearance: none;
                        ">
                            <option value="صيانة">⚡ صيانة</option>
                            <option value="تركيب">🛠️ تركيب</option>
                            <option value="معاينة">👁️ معاينة</option>
                        </select>
                        <div style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #aeaeae; pointer-events: none; font-size: 0.8rem;">▼</div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">اختيار الفني المسؤول</label>
                    <div style="position: relative; width: 100%;">
                        <select name="assignedTechnician" required style="
                            width: 100%; background: #121212; border: 1px solid #3a3a3c; color: white; padding: 12px 14px; border-radius: 8px; outline: none; font-size: 0.95rem; cursor: pointer; box-sizing: border-box; appearance: none; -webkit-appearance: none; -moz-appearance: none;
                        ">
                            <option value="" disabled selected style="color: #666;">اختر فني من القائمة...</option>
                            <% techs.forEach(tech => { %>
                                <option value="<%= tech._id %>">
                                    👤 <%= tech.name %> (<%= tech.specialty %>)
                                </option>
                            <% }) %>
                        </select>
                        <div style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #aeaeae; pointer-events: none; font-size: 0.8rem;">▼</div>
                    </div>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label style="color: #aeaeae; font-size: 0.9rem; font-weight: 600;">وصف العطل أو المهمة بالتفصيل</label>
                <textarea name="description" rows="4" required placeholder="اكتب تفاصيل وافية عما سيقوم به الفني عند العميل..." style="
                    width: 100%; background: #121212; border: 1px solid #3a3a3c; color: white; padding: 14px; border-radius: 8px; outline: none; font-size: 0.95rem; box-sizing: border-box; resize: none; line-height: 1.5; transition: all 0.3s ease;
                " onfocus="this.style.borderColor='#ffcc00'; this.style.boxShadow='0 0 0 3px rgba(255, 204, 0, 0.15)';" onblur="this.style.borderColor='#3a3a3c'; this.style.boxShadow='none';"></textarea>
            </div>
        </div>

        <button type="submit" style="
            width: 100%; 
            background: var(--accent, #ffcc00); 
            color: #000000; 
            border: none; 
            padding: 15px; 
            border-radius: 10px; 
            font-weight: 700; 
            font-size: 1.05rem; 
            cursor: pointer; 
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
            box-shadow: 0 4px 20px rgba(255, 204, 0, 0.2);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        " onmouseover="this.style.background='#e6b800'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 25px rgba(255, 204, 0, 0.35)';" onmouseout="this.style.background='var(--accent, #ffcc00)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 20px rgba(255, 204, 0, 0.2)';"
            onmousedown="this.style.transform='translateY(1px)';">
            <i class="fas fa-plus-circle" style="font-size: 1.15rem;"></i> إضافة المهمة وتنبيه الفني فوراً
        </button>

    </form>
</div>